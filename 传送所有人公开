UserInputService.InputChanged:Connect(function(input)
    if isUninstalled then return end
    
    if dragging and mainFrame and mainFrame.Parent then
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local currentPos = UserInputService:GetMouseLocation()
            local delta = currentPos - dragStart
            local newX = frameStart.X.Offset + delta.X
            local newY = frameStart.Y.Offset + delta.Y
            local screenSize = workspace.CurrentCamera.ViewportSize
            mainFrame.Position = UDim2.new(0, math.clamp(newX, 0, screenSize.X - mainFrame.AbsoluteSize.X), 0, math.clamp(newY, 0, screenSize.Y - mainFrame.AbsoluteSize.Y))
        end
    end
    
    if resizing and mainFrame and mainFrame.Parent and resizeStart and sizeStart then
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local currentPos = UserInputService:GetMouseLocation()
            local delta = currentPos - resizeStart
            local newW = math.clamp(sizeStart.Width + delta.X, 300, 600)
            local newH = math.clamp(sizeStart.Height + delta.Y, 400, 700)
            local framePos = mainFrame.Position
            local screenSize = workspace.CurrentCamera.ViewportSize
            if framePos.X.Offset + newW > screenSize.X then
                newW = screenSize.X - framePos.X.Offset
            end
            if framePos.Y.Offset + newH > screenSize.Y then
                newH = screenSize.Y - framePos.Y.Offset
            end
            mainFrame.Size = UDim2.new(0, newW, 0, newH)
            relayoutUI()
        end
    end
    
    if floatingDragging and floatingButton and floatingButton.Parent then
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local currentPos = UserInputService:GetMouseLocation()
            local delta = currentPos - floatingDragStart
            local newX = floatingStartPos.X.Offset + delta.X
            local newY = floatingStartPos.Y.Offset + delta.Y
            local screenSize = workspace.CurrentCamera.ViewportSize
            floatingButton.Position = UDim2.new(0, math.clamp(newX, 0, screenSize.X - 55), 0, math.clamp(newY, 0, screenSize.Y - 55))
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if resizing then
            resizing = false
            saveUIPosition()
        end
        if dragging then
            dragging = false
            saveUIPosition()
        end
        if floatingDragging then
            floatingDragging = false
            saveFloatingPosition()
        end
    end
end)

