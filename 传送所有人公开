local function getEnabledPlayers()
    local enabled = {}
    for _, plr in ipairs(currentPlayers) do
        if enabledPlayers[plr] then
            table.insert(enabled, plr)
        end
    end
    return enabled
end

local function teleportToPlayer(targetPlayer)
    local char = localPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local targetChar = targetPlayer and targetPlayer.Character
    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
        hrp.CFrame = targetChar.HumanoidRootPart.CFrame
    end
end

local function startCycle()
    if cycleConnection or not isCycling then return end
    cycleConnection = task.spawn(function()
        while isCycling and not isUninstalled do
            local others = getEnabledPlayers()
            if #others > 0 then
                if currentIndex > #others then currentIndex = 1 end
                teleportToPlayer(others[currentIndex])
                currentIndex = currentIndex + 1
                if currentIndex > #others then currentIndex = 1 end
            end
            task.wait(teleportInterval)
        end
    end)
end

local function stopCycle()
    if cycleConnection then
        task.cancel(cycleConnection)
        cycleConnection = nil
    end
    currentIndex = 1
end

local function updateFloatingButton()
    if not floatingButton or not floatingButton.Parent then return end
    local statusText = floatingButton:FindFirstChild("StatusText")
    if statusText then
        statusText.Text = isCycling and "传送中" or "已停止"
        statusText.TextColor3 = isCycling and Color3.fromRGB(100,255,100) or Color3.fromRGB(255,100,100)
    end
end

local function updateMainUI()
    if not mainFrame or not mainFrame.Parent or isUninstalled then return end
    local statusLabel = mainFrame:FindFirstChild("StatusLabel")
    local button = mainFrame:FindFirstChild("ToggleButton")
    if statusLabel and button then
        local enabledCount = #getEnabledPlayers()
        statusLabel.Text = string.format("状态: %s | 追踪: %d/%d人", isCycling and "开启 ✓" or "关闭 ✗", enabledCount, #currentPlayers)
        statusLabel.TextColor3 = isCycling and Color3.fromRGB(100,255,100) or Color3.fromRGB(220,220,220)
        button.Text = isCycling and "关闭循环" or "开启循环"
        button.BackgroundColor3 = isCycling and Color3.fromRGB(200,50,50) or Color3.fromRGB(0,120,210)
    end
    updateFloatingButton()
end

local function toggleCycle()
    if isUninstalled then return end
    isCycling = not isCycling
    if isCycling then startCycle() else stopCycle() end
    updateMainUI()
end

local function setInterval(value)
    if isUninstalled then return end
    local num = tonumber(value)
    if num then
        teleportInterval = math.clamp(num, 0.00001, 1)
        if isCycling then
            stopCycle()
            startCycle()
        end
    end
end

local function saveUIPosition()
    if mainFrame and mainFrame.Parent and not isUninstalled then
        savedUIPosition = {X = mainFrame.Position.X.Offset, Y = mainFrame.Position.Y.Offset}
        savedUISize = {Width = mainFrame.Size.X.Offset, Height = mainFrame.Size.Y.Offset}
    end
end

local function saveFloatingPosition()
    if floatingButton and floatingButton.Parent and not isUninstalled then
        savedFloatingPos = {X = floatingButton.Position.X.Offset, Y = floatingButton.Position.Y.Offset}
    end
end

local function toggleUIVisibility()
    uiVisible = not uiVisible
    if mainFrame then
        mainFrame.Visible = uiVisible
    end
end

local function togglePlayer(player)
    if not player then return end
    enabledPlayers[player] = not enabledPlayers[player]
    
    local btn = playerButtons[player]
    if btn and btn.Parent then
        if enabledPlayers[player] then
            btn.BackgroundColor3 = Color3.fromRGB(0, 130, 90)
            btn.Text = "● " .. player.Name
        else
            btn.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
            btn.Text = "○ " .. player.Name
        end
    end
    
    if isCycling then
        local enabled = getEnabledPlayers()
        if currentIndex > #enabled and #enabled > 0 then
            currentIndex = 1
        end
    end
    updateMainUI()
end

local function selectAll()
    for _, plr in ipairs(currentPlayers) do
        enabledPlayers[plr] = true
        local btn = playerButtons[plr]
        if btn and btn.Parent then
            btn.BackgroundColor3 = Color3.fromRGB(0, 130, 90)
            btn.Text = "● " .. plr.Name
        end
    end
    updateMainUI()
end

local function selectNone()
    for _, plr in ipairs(currentPlayers) do
        enabledPlayers[plr] = false
        local btn = playerButtons[plr]
        if btn and btn.Parent then
            btn.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
            btn.Text = "○ " .. plr.Name
        end
    end
    updateMainUI()
end

local function rebuildPlayerList()
    if not playerListContainer or not playerListContainer.Parent then
        return
    end
    
    for _, child in ipairs(playerListContainer:GetChildren()) do
        child:Destroy()
    end
    playerButtons = {}
    
    currentPlayers = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer then
            table.insert(currentPlayers, plr)
        end
    end
    table.sort(currentPlayers, function(a,b) return a.Name < b.Name end)
    
    for _, plr in ipairs(currentPlayers) do
        if enabledPlayers[plr] == nil then
            enabledPlayers[plr] = true
        end
    end
    
    for plr, _ in pairs(enabledPlayers) do
        local exists = false
        for _, newPlr in ipairs(currentPlayers) do
            if newPlr == plr then
                exists = true
                break
            end
        end
        if not exists then
            enabledPlayers[plr] = nil
        end
    end
    
    if #currentPlayers == 0 then
        local emptyLabel = Instance.new("TextLabel")
        emptyLabel.Size = UDim2.new(1, -10, 0, 50)
        emptyLabel.Position = UDim2.new(0, 5, 0, 10)
        emptyLabel.Text = "暂无其他玩家"
        emptyLabel.TextColor3 = Color3.fromRGB(150,150,170)
        emptyLabel.BackgroundTransparency = 1
        emptyLabel.Font = Enum.Font.Gotham
        emptyLabel.TextSize = 16
        emptyLabel.Parent = playerListContainer
        playerListContainer.Size = UDim2.new(1, 0, 0, 70)
        
        if playerScroll then
            playerScroll.CanvasSize = UDim2.new(0, 0, 0, 70)
        end
        updateMainUI()
        return
    end
    
    local buttonHeight = 38
    local padding = 4
    
    for i, plr in ipairs(currentPlayers) do
        local isEnabled = enabledPlayers[plr]
        
        local playerBtn = Instance.new("TextButton")
        playerBtn.Size = UDim2.new(1, -10, 0, buttonHeight)
        playerBtn.Position = UDim2.new(0, 5, 0, (i-1) * (buttonHeight + padding))
        playerBtn.BackgroundColor3 = isEnabled and Color3.fromRGB(0, 130, 90) or Color3.fromRGB(70, 70, 90)
        playerBtn.Text = (isEnabled and "● " or "○ ") .. plr.Name
        playerBtn.TextColor3 = Color3.new(1,1,1)
        playerBtn.Font = Enum.Font.Gotham
        playerBtn.TextSize = 16
        playerBtn.TextXAlignment = Enum.TextXAlignment.Left
        playerBtn.Parent = playerListContainer
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 6)
        btnCorner.Parent = playerBtn
        
        local plrRef = plr
        playerBtn.MouseButton1Click:Connect(function()
            togglePlayer(plrRef)
        end)
        
        playerButtons[plr] = playerBtn
    end
    
    local totalHeight = #currentPlayers * (buttonHeight + padding) + 10
    playerListContainer.Size = UDim2.new(1, 0, 0, totalHeight)
    
    if playerScroll then
        playerScroll.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
    end
    
    updateMainUI()
end

local function refreshPlayerList()
    if not playerListContainer or not playerListContainer.Parent then
        return
    end
    rebuildPlayerList()
end

local function uninstallScript()
    if isUninstalled then return end
    
    isCycling = false
    stopCycle()
    
    if screenGui then
        pcall(function() screenGui:Destroy() end)
        screenGui = nil
    end
    mainFrame = nil
    floatingButton = nil
    playerListContainer = nil
    playerScroll = nil
    playerButtons = {}
    
    isUninstalled = true
    
    game.StarterGui:SetCore("SendNotification", {Title = "卸载完成", Text = "脚本已完全卸载", Duration = 2})
end

local function destroyUI()
    if screenGui then
