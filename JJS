local cframeSpeed = 0
LocalTab:Slider({
    Title = "CFrame加速",
    Value = { Min = 0, Max = 10, Default = 0, Step = 0.1 },
    Callback = function(value)
        cframeSpeed = value
    end
})

local velocitySpeed = 0
LocalTab:Slider({
    Title = "Velocity加速",
    Value = { Min = 0, Max = 500, Default = 0, Step = 1 },
    Callback = function(value)
        velocitySpeed = value
    end
})

RunService.Stepped:Connect(function()
    if cframeSpeed > 0 and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        local moveDir = LocalPlayer.Character.Humanoid.MoveDirection
        if moveDir.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (moveDir * cframeSpeed)
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if velocitySpeed > 0 and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        local moveDir = LocalPlayer.Character.Humanoid.MoveDirection
        if moveDir.Magnitude > 0 then
            hrp.AssemblyLinearVelocity = moveDir * velocitySpeed
        end
    end
end)

local SettingTab = Window:Tab({ Title = "设置", Icon = "settings" })

SettingTab:Section({ Title = "反AFK", Icon = "user" })

local VirtualUser = game:GetService("VirtualUser")
local AntiAFK = true

local function startAntiAFK()
    task.spawn(function()
        game.Players.LocalPlayer.Idled:Connect(function()
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end)
        while AntiAFK do
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
            task.wait(60)
        end
    end)
end

SettingTab:Toggle({
    Title = "反AFK",
    Value = AntiAFK,
    Callback = function(enabled)
        AntiAFK = enabled
    end
})

SettingTab:Section({ Title = "服务器", Icon = "server" })

SettingTab:Button({
    Title = "服务器跳转",
    Callback = function()
        local TeleportService = game:GetService("TeleportService")
        local servers = {}
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"))
        end)
        if success and result and result.data then
            for _, server in ipairs(result.data) do
                if server.id ~= game.JobId and server.playing < server.maxPlayers then
                    table.insert(servers, server.id)
                end
            end
        end
        if #servers > 0 then
            WindUI:Notify({ Title = "服务器跳转", Content = "正在传送到其他服务器...", Duration = 2, Icon = "server" })
            task.wait(1)
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], LocalPlayer)
        else
            WindUI:Notify({ Title = "服务器跳转失败", Content = "未找到可用服务器。", Duration = 3, Icon = "alert-triangle" })
        end
    end
})

SettingTab:Button({
    Title = "重新加入",
    Callback = function()
        WindUI:Notify({ Title = "重新加入", Content = "正在重新加入服务器...", Duration = 2, Icon = "refresh-cw" })
        task.wait(1)
        game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
    end
})

